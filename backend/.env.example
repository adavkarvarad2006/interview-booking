# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection String (e.g. from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/interview_counselling_db?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=replace_with_a_long_secure_random_string_in_production

# Frontend Application URL (for CORS)
CLIENT_URL=https://your-frontend-domain.vercel.app

# Calendly Integration Settings
CALENDLY_API_KEY=your_calendly_personal_access_token
CALENDLY_WEBHOOK_SIGNING_KEY=your_calendly_webhook_signing_key
CALENDLY_15_MIN_URL=https://calendly.com/your-counsellor/15-min-interview-counselling
CALENDLY_30_MIN_URL=https://calendly.com/your-counsellor/30-min-mock-interview-training

# Email Service Configuration (Nodemailer - Gmail SMTP)
# Create an App Password at https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME="InterviewPrep Portal"
SMTP_FROM="InterviewPrep Portal" <your-email@gmail.com>
